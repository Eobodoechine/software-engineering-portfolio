# Copy to .env.local for Next.js; the worker reads .env via dotenv.
# Use your own local Redis. Provider calls require your own account and can cost money.
PV_LOCAL_DEMO=true
REDIS_URL=redis://127.0.0.1:6379
# For the separate worker process: RUN_WORKER=true PORT=8081 npm run worker
VERTEX_AI_PROJECT_ID=your-google-cloud-project
GOOGLE_CLOUD_PROJECT=your-google-cloud-project
VERTEX_AI_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-pro
GOOGLE_MAPS_API_KEY=
PV_MAX_CONCURRENT_JOBS=1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NOTIFICATION_EMAIL=operator@example.invalid
